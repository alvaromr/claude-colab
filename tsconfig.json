{
  // The mod, on the types Claude Code lays when it loads it; the CLI, which runs on Node, has tsconfig.cli.json.
  "extends": "./plugins/colab/.claude-plugin/types/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // What the mod imports from cli/ is checked here too, with no Node types: it must need none.
  "include": ["plugins/colab/hooks", "plugins/colab/types", "tests/mod"],
  // Node runs these, with its types: tsconfig.cli.json checks them.
  "exclude": ["tests/mod/*.test.mts"]
}
