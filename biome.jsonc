{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!plugins/colab/.claude-plugin/types"] },
  // Prettier formats; Biome only lints.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
      },
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
      },
      "nursery": {
        "noFloatingPromises": "error",
      },
    },
  },
  "overrides": [
    // The architecture: the mod runs where there is no Node, and of the CLI reads only what both agree on, which
    // imports nothing; the CLI knows nothing of the mod.
    {
      "includes": ["plugins/colab/hooks/**", "plugins/colab/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["node:*"], "message": "The mod runs where there is no Node." },
                  {
                    "group": ["../cli/*", "!../cli/protocol.mts"],
                    "message": "Of the CLI, the mod imports only protocol.mts, what both agree on.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      "includes": ["plugins/colab/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["../hooks/*", "../types/*"], "message": "The CLI knows nothing of the mod." }],
              },
            },
          },
        },
      },
    },
    {
      "includes": ["plugins/colab/cli/protocol.mts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["**"], "message": "protocol.mts imports nothing: the mod, with no Node, imports it." },
                ],
              },
            },
          },
        },
      },
    },
    {
      // The mod's pure modules, which Node tests: no engine, nor anything else but the protocol, pure too.
      "includes": ["plugins/colab/hooks/addresses.ts", "plugins/colab/hooks/chat.ts", "plugins/colab/hooks/linking.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!../cli/protocol.mts"],
                    "message": "A pure module of the mod imports only the protocol: Node tests it.",
                  },
                ],
              },
            },
          },
        },
      },
    },
    {
      // The rules of the rooms are pure: their sockets are hub.mts's.
      "includes": ["plugins/colab/cli/rooms.mts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["**", "!./protocol.mts"], "message": "rooms.mts is pure: no I/O." }],
              },
            },
          },
        },
      },
    },
    {
      // The CLI's entry point answers on stdout and stderr: that is its interface, not logging.
      "includes": ["plugins/colab/cli/claude-colab.mts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } },
    },
  ],
}
